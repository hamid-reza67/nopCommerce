@{
    string script = @"
    <script>
      var swiper = new Swiper('.product-thumb-slider', {
          spaceBetween: 11,
          slidesPerView: 'auto',
          freeMode: true,
          watchSlidesProgress: true
      });
      var swiper2 = new Swiper('.product-slider', {
          spaceBetween: 10,
          pagination: {
              el: '.swiper-pagination',
          },
          thumbs: {
              swiper: swiper,
          },
      });
      $('#zoom-image').on('click',function(){
          $('.product-slider .swiper-slide-active a').trigger('click');
      });
      $('.variation-radio .radio input[type=""radio""]').on('change',function(){
          $('.variation-radio .radio').css('border-color','#EBEBEB');
          if ($(this).is(':checked')) {
              $(this).closest('.radio').css('border-color','#44B96B');
          }
      });
    </script>
    ";

    NopHtml.AddInlineScriptParts(ResourceLocation.Footer, script);
}