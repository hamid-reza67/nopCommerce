                                            <div class="title">نوع اتصال     </div>
                                            <div class="value">هشت گیگابایت</div>
                                        </div>
                                        <div class="attr">
                                            <div class="title">نوع اتصال     </div>
                                            <div class="value">هشت گیگابایت</div>
                                        </div>
                                        <div class="attr">
                                            <div class="title">نوع اتصال     </div>
                                            <div class="value">هشت گیگابایت</div>
                                        </div>
                                        <div class="attr">
                                            <div class="title">نوع اتصال     </div>
                                            <div class="value">هشت گیگابایت</div>
                                        </div>
                                        <div class="attr">
                                            <div class="title">نوع اتصال     </div>
                                            <div class="value">هشت گیگابایت</div>
                                        </div>
                                        <div class="attr">
                                            <div class="title">نوع اتصال     </div>
                                            <div class="value">هشت گیگابایت</div>
                                        </div>
                                    </div>
