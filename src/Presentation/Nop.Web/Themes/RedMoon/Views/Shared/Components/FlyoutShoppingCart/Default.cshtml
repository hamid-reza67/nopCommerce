@model MiniShoppingCartModel

@using Nop.Core.Domain.Catalog



<div id="flyout-cart" class="basket-dropdown">
    @if (Model.TotalProducts == 0)
    {

        <div class="basket-header">@T("ShoppingCart.Mini.NoItems")</div>
    }
    else
    {

        <div class="basket-header">
            @Html.Raw(string.Format(T("ShoppingCart.Mini.ItemsText").Text, $"<a href=\"{Url.RouteUrl("ShoppingCart")}\">{string.Format(T("ShoppingCart.Mini.Items").Text, Model.TotalProducts)}</a>"))
        </div>
    }

    @if (Model.TotalProducts > 0)
    {
        <div class="basket-body">
            <ul class="basket-items">
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    <li class="basket-item">
                        @if (Model.ShowProductImages)
                        {
                            <a href="@(Url.RouteUrl<Product>(new { SeName = item.ProductSeName }))" title="@item.Picture.Title">
                                <img alt="@item.Picture.AlternateText" src="@item.Picture.ImageUrl" title="@item.Picture.Title" height="70" width="70" />
                            </a>
                        }
                        <div class="info">
                            <a class="item-name" href="@(Url.RouteUrl<Product>(new { SeName = item.ProductSeName }))">@item.ProductName</a>
                            @if (!string.IsNullOrEmpty(item.AttributeInfo))
                            {
                                <div class="attributes">
                                    @Html.Raw(item.AttributeInfo)
                                </div>
                            }
                            <p class="item-price">@T("ShoppingCart.Mini.UnitPrice"): @item.UnitPrice</p>
                            <div class="d-flex align-items-end justify-content-between">
                                <p class="item-count">@T("ShoppingCart.Mini.Quantity"): @item.Quantity</p>
                                <button class="remove-item"><span class="icon icon-trash"></span></button>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
        <div class="basket-footer">
            <p class="total-price">
                @T("ShoppingCart.Totals.SubTotal"): <span>@Model.SubTotal</span>
            </p>
            @if (Model.DisplayShoppingCartButton)
            {
                <button type="button" class="btn btn-secondary cart-button" onclick="setLocation('@(Url.RouteUrl("ShoppingCart"))')">@T("ShoppingCart.Mini.ViewCart")</button>
            }
            @if (Model.DisplayCheckoutButton)
            {
                var checkoutUrl = "";
                if (Model.AnonymousCheckoutAllowed && Model.CurrentCustomerIsGuest)
                {
                    checkoutUrl = Url.RouteUrl("LoginCheckoutAsGuest", new { returnUrl = Url.RouteUrl("ShoppingCart") });
                }
                else
                {
                    checkoutUrl = Url.RouteUrl("Checkout");
                }
                <button type="button" class="button-1 checkout-button" onclick="setLocation('@checkoutUrl')">@T("Checkout.Button")</button>
            }
            
        </div>
    }
</div>




